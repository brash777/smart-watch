# =============================================================================
# Snapia environment variables
# -----------------------------------------------------------------------------
# Copy this file to .env (cp .env.example .env) and adjust it. Never commit .env.
# The API validates every variable when it starts (apps/api/src/config/env.ts):
# if one is missing or invalid, it refuses to start and names the variable.
# Docker Compose reads the "Docker services" values from the same .env file.
# Every value below is a safe default for local development only.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# Runtime environment: development | test | production.
NODE_ENV=development
# Product name returned by the API (GET /api/health) and written in the logs.
APP_NAME=Snapia
# Log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
# Port the API listens on.
API_PORT=4000
# Public URL of the API.
API_BASE_URL=http://localhost:4000
# Public URL of the web app (for links the API generates).
WEB_BASE_URL=http://localhost:5173
# Browser origins allowed to call the API, separated by commas.
CORS_ORIGINS=http://localhost:5173
# Maximum size of a JSON request body (e.g. 100kb, 1mb).
JSON_BODY_LIMIT=1mb

# -----------------------------------------------------------------------------
# Docker services (docker-compose.yml)
# -----------------------------------------------------------------------------
# Prefix of the containers and volumes that Docker Compose creates.
COMPOSE_PROJECT_NAME=snapia
# PostgreSQL user, password and database created on the first start.
POSTGRES_USER=snapia
POSTGRES_PASSWORD=snapia_local_password
POSTGRES_DB=snapia
# Port of PostgreSQL on your machine. 5433 avoids clashing with a PostgreSQL
# installed locally on the default port 5432.
POSTGRES_PORT=5433
# MinIO administrator, only for the MinIO console and the minio-init container.
# The API never uses it: it uses S3_ACCESS_KEY / S3_SECRET_KEY below.
MINIO_ROOT_USER=snapia-admin
MINIO_ROOT_PASSWORD=snapia_local_minio_password
# Ports of the MinIO S3 API and of its web console on your machine.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection URL used by the API. Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://snapia:snapia_local_password@localhost:5433/snapia?schema=public
# Separate database for the API integration tests (npm test). The tests delete all of
# its data, so it must never be the DATABASE_URL database. It is created and migrated
# automatically when the tests start.
TEST_DATABASE_URL=postgresql://snapia:snapia_local_password@localhost:5433/snapia_test?schema=public

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Secrets that sign the access and refresh tokens: at least 32 characters and
# different from each other. For real ones run: openssl rand -base64 48
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-0123456789
# Token lifetimes: a whole number followed by s, m, h or d.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# bcrypt cost factor for password hashes (higher is slower and safer).
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------
# Where photos are stored: s3 (MinIO locally, any S3-compatible service in
# production) or local (a folder on disk).
STORAGE_DRIVER=s3
# Folder for photos when STORAGE_DRIVER=local.
LOCAL_STORAGE_DIR=./storage
# S3 endpoint and region. Locally, MinIO on MINIO_API_PORT.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Bucket for the photos (created locally by the minio-init container).
S3_BUCKET=snapia-local
# Credentials the API uses for S3 (created locally by the minio-init container).
S3_ACCESS_KEY=snapia-app
S3_SECRET_KEY=snapia_local_app_secret
# Use path-style URLs (http://host/bucket/key). MinIO needs true.
S3_FORCE_PATH_STYLE=true
# Lifetime, in seconds, of the signed URLs used to view or upload photos.
SIGNED_URL_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# Uploads and images
# -----------------------------------------------------------------------------
# Maximum size of one uploaded photo, in megabytes.
UPLOAD_MAX_MB=15
# Maximum number of photos in one upload request.
UPLOAD_MAX_FILES=10
# Accepted photo types (MIME), separated by commas.
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp
# Longest side, in pixels, of a stored photo (bigger photos are scaled down).
IMAGE_MAX_SIDE_PX=2048
# Longest side, in pixels, of a thumbnail.
THUMBNAIL_SIDE_PX=400

# -----------------------------------------------------------------------------
# AI
# -----------------------------------------------------------------------------
# AI provider: mock (fixed answers, no network, no cost) or anthropic (Claude API).
AI_PROVIDER=mock
# Claude API key. Only required when AI_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
# Claude model id used for every AI task.
AI_MODEL=claude-opus-5-5
# Maximum output tokens of one AI call.
AI_MAX_TOKENS=16000
# Reasoning effort: low | medium | high | xhigh | max. More effort gives better
# answers at a higher cost and latency. (Claude no longer accepts a temperature.)
# Used by every AI task that has no effort of its own.
AI_EFFORT=medium
# Effort of the quick analysis that runs on every new snap (same values as AI_EFFORT).
AI_SNAP_ANALYSIS_EFFORT=low
# Speed of that analysis: standard, or fast (Claude's fast mode: quicker answers that
# cost ai_fast_mode_price_multiplier times more, only on models that support it).
AI_SNAP_ANALYSIS_SPEED=standard
# Timeout of one AI call, in milliseconds.
AI_TIMEOUT_MS=300000
# Automatic retries of an AI call that fails for network or rate-limit reasons.
AI_MAX_RETRIES=2
# Longest side, in pixels, of the images sent to the AI (cost grows with pixel area).
AI_IMAGE_MAX_SIDE_PX=1568
# Format (jpeg | webp) and quality (1-100) of the images sent to the AI.
AI_IMAGE_FORMAT=jpeg
AI_IMAGE_QUALITY=90
# AI jobs that the background queue runs at the same time.
AI_QUEUE_CONCURRENCY=2
# Maximum characters of notes and insights sent in one AI request.
AI_CONTEXT_MAX_CHARS=60000

# -----------------------------------------------------------------------------
# Web app (apps/web, Vite)
# -----------------------------------------------------------------------------
# Product name shown in the web app and in the installed PWA.
VITE_APP_NAME=Snapia
# Base URL of the API for the browser. A relative path such as /api goes through
# the Vite proxy below, so a phone on the same network can use it too
# (npm run dev:web -- --host). In production, the public URL of the API.
VITE_API_URL=/api
# Where the Vite dev server forwards VITE_API_URL: the API (API_BASE_URL).
VITE_API_PROXY_TARGET=http://localhost:4000
# Link that opens WhatsApp with a message ready to send (Space invites).
VITE_WHATSAPP_SHARE_URL=https://wa.me/
# Quality (0-1) of the JPEG the browser makes when it scales a photo down to
# IMAGE_MAX_SIDE_PX before uploading it.
VITE_UPLOAD_IMAGE_QUALITY=0.9

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Time window, in milliseconds, in which requests are counted per client.
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per client and window for the whole API.
RATE_LIMIT_MAX=300
# Maximum requests per client and window for login and sign-up.
AUTH_RATE_LIMIT_MAX=20

# -----------------------------------------------------------------------------
# Pagination
# -----------------------------------------------------------------------------
# Items per page when a request does not send ?limit=.
PAGINATION_DEFAULT_LIMIT=20
# Largest ?limit= a request may ask for.
PAGINATION_MAX_LIMIT=50

# -----------------------------------------------------------------------------
# Seed (npm run db:seed)
# -----------------------------------------------------------------------------
# First ADMIN account, created by the seed.
SEED_ADMIN_NAME="Snapia Admin"
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-local-admin-password
# true to also create demo users, Spaces and snaps.
SEED_DEMO_DATA=true
